{
  "name": "@grues-in-comic/web",
  "version": "0.1.0",
  "description": "The website — static pages at the root and the game at /play/, the browser shell over the ADR 0002 event stream (stages 5.2–5.3, 6.3). Local only until the 1.0.0 release; the recorded origin is https://grues.danielkimdev.com. Folder rename to `website/` deferred, see docs/FUTURE_WORK.md",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "serve": "tsx tools/serve.ts",
    "dev": "npm run build && npm run serve",
    "render:panel": "tsx tools/render-panel.ts",
    "render:bodies": "tsx tools/render-bodies.ts",
    "render:tldr": "tsx tools/render-tldr.ts",
    "gate": "tsx tools/gate.ts",
    "gate:accept": "tsx tools/gate.ts --accept",
    "density": "tsx tools/density.ts",
    "density:accept": "tsx tools/density.ts --accept",
    "changelog": "tsx tools/build-changelog.ts",
    "sitemap": "tsx tools/build-sitemap.ts",
    "make-walkthrough-save": "tsx tools/make-walkthrough-save.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
