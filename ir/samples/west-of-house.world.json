    { "id": "RLANDBIT", "description": "Room is dry land (travel without a vehicle)" },
    { "id": "ONBIT", "description": "Room is lit / object is providing light" },
    { "id": "SACREDBIT", "description": "The thief does not visit this room" },
    { "id": "CONTBIT", "description": "Object is a container" },
    { "id": "TRYTAKEBIT", "description": "Parser routes TAKE to the object's action first" },
    { "id": "READBIT", "description": "Object can be read (has text)" },
    { "id": "TAKEBIT", "description": "Object can be picked up" },
    { "id": "BURNBIT", "description": "Object is flammable" },
    { "id": "DOORBIT", "description": "Object is a door (door exits test its OPENBIT)" },
    { "id": "NDESCBIT", "description": "Object is not listed in room descriptions" },
    { "id": "OPENBIT", "description": "Container/door is currently open (runtime state)" }
