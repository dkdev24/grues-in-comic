    { "id": "FALSE-FLAG", "value": false, "description": "Never set — used for permanently refused conditional exits" },
    { "id": "KITCHEN-WINDOW-FLAG", "value": false, "description": "Set once the kitchen window has been opened; changes its examine text" }
